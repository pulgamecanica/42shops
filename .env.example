# From https://profile.intra.42.fr/oauth/applications (your app's page)
FT_CLIENT_ID=u-s4t2ud-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FT_CLIENT_SECRET=s-s4t2ud-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Random string, at least 32 characters. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Public URL of the site, without trailing slash. The 42 app's redirect URI
# must be exactly  ${APP_URL}/api/auth/callback
# Optional: when empty, the request origin is used.
APP_URL=http://localhost:3000

# Upstash Redis: caches every campus's products (shared by all instances and
# deploys) and stores view counts. On Vercel, add Upstash Redis from the
# Storage tab and these are set for you (the KV_REST_API_* names also work).
# Locally, `docker compose up -d` runs Redis behind the same REST API:
#   UPSTASH_REDIS_REST_URL=http://localhost:8079
#   UPSTASH_REDIS_REST_TOKEN=local-dev-token
# Left empty, everything is kept in memory and resets on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
